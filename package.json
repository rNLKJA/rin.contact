{
  "name": "rin-contact",
  "version": "5.27.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/generate-topic-skills.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "deploy": "vercel --prod",
    "prepare": "husky",
    "check:career": "node --no-warnings scripts/check-career-data.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,json,css,md}": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.3",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=22.x"
  },
  "browserslist": {
    "production": [
      "chrome >= 93",
      "firefox >= 92",
      "safari >= 15.4",
      "edge >= 93"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright": "^1.64.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.0"
  }
}
